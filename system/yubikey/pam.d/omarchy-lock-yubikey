#%PAM-1.0
# YubiKey touch-to-unlock for the scrogson.lock lock screen (runs as the user,
# challenge file in ~/.yubico). No pam_faillock on purpose: the lock screen
# retries this silently while the key is absent or untouched.
auth       required    pam_yubico.so mode=challenge-response
account    include     system-local-login
