#%PAM-1.0
# Local override of /usr/lib/pam.d/polkit-1: YubiKey (slot 2 challenge-response)
# first, falling back to the password. Delete this file to restore the default.
auth       sufficient   pam_yubico.so mode=challenge-response chalresp_path=/var/yubico
auth       include      system-auth
account    include      system-auth
password   include      system-auth
session    include      system-auth
