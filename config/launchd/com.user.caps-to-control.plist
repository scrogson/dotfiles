<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.caps-to-control</string>
    <!-- launchd does not expand ~ or $VAR in ProgramArguments, so shell out
         to resolve $HOME at runtime and keep this file user-agnostic. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec "$HOME/.dotfiles/scripts/caps-to-control.sh"</string>
    </array>
    <!-- One-shot: hidutil sets the mapping and exits. KeepAlive would respawn
         it forever. RunAtLoad re-applies it on every login, which is what
         makes the session-scoped mapping stick across reboots. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/caps-to-control.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/caps-to-control.err</string>
</dict>
</plist>
