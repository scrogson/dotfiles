<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.theme-watcher</string>
    <!-- launchd does not expand ~ or $VAR in ProgramArguments, so shell out
         to resolve $HOME at runtime and keep this file user-agnostic. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec "$HOME/.dotfiles/scripts/theme-watcher.sh"</string>
    </array>
    <!-- launchd starts jobs with a bare PATH that omits Homebrew, so anything
         installed there (fish, and whatever a theme script reaches for next)
         is invisible without this. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/theme-watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/theme-watcher.err</string>
</dict>
</plist>
