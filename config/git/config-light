[delta]
syntax-theme = github-light
navigate = true
dark = false
side-by-side = true
line-numbers = true
max-line-length = 0
hyperlinks = true
hyperlinks-file-link-format = "file://{path}"

# GitHub Light colors
minus-style = syntax "#ffebe9"
minus-emph-style = syntax "#ffc1bc"
plus-style = syntax "#dafbe1"
plus-emph-style = syntax "#aff5b4"
line-numbers-minus-style = "#cf222e"
line-numbers-plus-style = "#1a7f37"
line-numbers-zero-style = "#57606a"
line-numbers-left-style = "#57606a"
line-numbers-right-style = "#57606a"
hunk-header-style = file line-number syntax
hunk-header-decoration-style = "#d0d7de" box
file-style = "#0969da" bold
file-decoration-style = "#0969da" ul